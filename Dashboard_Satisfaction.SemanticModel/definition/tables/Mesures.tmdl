	measure 'CSAT Couleur' = ```
			
			VAR CSAT_Valeur = AVERAGE('dataset_satisfaction_telecom'[csat])
			VAR Seuil_Mauvais = 2.4
			VAR Seuil_Bon = 4
			
			RETURN
			    SWITCH(
			        TRUE(),
			        // Vert pour Élevé
			        CSAT_Valeur >= Seuil_Bon, "green", 
			        
			        // Rouge pour Mauvais
			        CSAT_Valeur < Seuil_Mauvais, "red", 
			
			        // Orange pour Bon (Moyen)
			        TRUE(), "orange" 
			    )
			```
		lineageTag: 737145c5-ddb2-4378-b6f3-45188284bc36

	measure NPS_Couleur_bis = ```
			
			VAR npsValue = [NPS]
			    
			RETURN

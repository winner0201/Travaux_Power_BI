	measure 'Client sur X' =
			
			VAR ChurnRate = [Taux_Churn]   -- déjà au format décimal (ex : 0.134)
			VAR X = DIVIDE(1, ChurnRate)
			RETURN
			"📌 environ 1 client sur " & FORMAT(X, "0") & " quitte l'opérateur dans la période"
		lineageTag: 540aa077-460e-41e7-8e93-f7cc39fd3b75


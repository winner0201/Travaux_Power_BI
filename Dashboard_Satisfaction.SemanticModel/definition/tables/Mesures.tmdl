	measure 'CSAT Etoiles Display' = ```
			
			VAR score = AVERAGE('dataset_satisfaction_telecom'[csat])
			VAR etoiles =
			    SWITCH(
			        TRUE(),
			        score >= 4.5, "😊",
			        score >= 4.0, "😊",
			        score >= 3.0, "😐",
			        score >= 2.0, "😡",
			        "😡"
			    )
			RETURN  "  (" & FORMAT(score, "0.0") & " / 5)" & etoiles
			
			```

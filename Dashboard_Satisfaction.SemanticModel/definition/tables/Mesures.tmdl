table Mesures
	lineageTag: 950be7be-2b30-4696-802f-1c002529a68f

	measure NPS = ```
			
			
			Var Nb_Promoteurs = CALCULATE(
			    COUNTROWS('dataset_satisfaction_telecom'),
			    'dataset_satisfaction_telecom'[nps_score] >= 9
			)
			
			var Nb_Detracteurs = CALCULATE(
			    COUNTROWS('dataset_satisfaction_telecom'),
			    'dataset_satisfaction_telecom'[nps_score] <= 6
			)
			
			var Total_Clients = COUNTROWS('dataset_satisfaction_telecom')
			
			
			VAR NPS_F= DIVIDE(Nb_Promoteurs - Nb_Detracteurs, Total_Clients, 0)
			
			RETURN NPS_F
			
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 1d7420fb-4972-4928-a53b-e74c5efb54c3

	measure Total_Clients = COUNTROWS('dataset_satisfaction_telecom')
		formatString: 0
		lineageTag: db6c24a4-b7e2-4b10-ad71-d098c829f40a

	measure CSAT =
			
			Var Nb_csat = CALCULATE(
			     COUNTROWS('dataset_satisfaction_telecom'),
			    'dataset_satisfaction_telecom'[csat] >= 4)
			    RETURN DIVIDE(Nb_csat,[Total_Clients])
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: f28941e8-53a7-4763-b4cc-9ff554447c98

	measure CES = ```
			
			Var Ces_Faible = DIVIDE(CALCULATE(
			    COUNTROWS('dataset_satisfaction_telecom'),
			    'dataset_satisfaction_telecom'[Categorie_ces] ="Aucun effort"
			),[Total_Clients])
			
			var Ces_Forte = DIVIDE(CALCULATE(
			    COUNTROWS('dataset_satisfaction_telecom'),
			    'dataset_satisfaction_telecom'[Categorie_ces] ="Effort très important"
			),[Total_Clients])
			
			RETURN  Ces_Faible - Ces_Forte 
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: ab8fb502-c01b-4849-a089-50e19207440c

	measure 'Part CES (%)' = ```
			
			DIVIDE(
			    COUNTROWS('dataset_satisfaction_telecom'),
			    CALCULATE(COUNTROWS('dataset_satisfaction_telecom'), ALL('dataset_satisfaction_telecom'))
			)
			
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 43e2279e-1128-44cb-8195-39be8f088ffc

	measure 'NPS couleur' =
			
			VAR csatValue = SELECTEDVALUE(dataset_satisfaction_telecom[nps_score])
			VAR Couleur =
			    SWITCH(
			        TRUE(),
			        csatValue <= 6 , "#D62728",     -- Rouge
			        csatValue >= 9 , "#2CA02C" ,   -- Vert
			        TRUE(), "#FF7F0E"             -- Orange
			    )
			    RETURN Couleur
		lineageTag: 7339f2ac-1ca4-4eef-8232-41b13f2e7185


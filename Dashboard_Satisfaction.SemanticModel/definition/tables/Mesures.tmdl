	measure Taux_Churn_Mensuel = ```
			
			DIVIDE(
			    CALCULATE(COUNTROWS('dataset_satisfaction_telecom'), 'dataset_satisfaction_telecom'[churn] = 0, DATESINPERIOD('dataset_satisfaction_telecom'[Dates], MAX('dataset_satisfaction_telecom'[Dates]), -1, MONTH)),
			    CALCULATE(COUNTROWS('dataset_satisfaction_telecom'), DATESINPERIOD('dataset_satisfaction_telecom'[Dates], MAX('dataset_satisfaction_telecom'[Dates]), -1, MONTH)),
			    0
			) 
			
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: eaaba2aa-52e2-414c-8acd-686ae65769b1

	measure Variation_CSAT_Mois = ```
			
			VAR Mois_Prec = CALCULATE(
			    [CSAT],
			    DATEADD('Dates'[Date], -1,MONTH)
			)
			VAR  Variation_CSAT = DIVIDE( CALCULATE(
			[CSAT] - Mois_Prec), Mois_Prec)*100
			VAR Variation = 
			SWITCH(
			    TRUE(),
			    Variation_CSAT > 0, "+" & FORMAT(Variation_CSAT, "0") & "%" & "△",
			    Variation_CSAT < 0, FORMAT(Variation_CSAT, "0") & "%" &  "▽",
			    "↔ 0"
			)
			RETURN Variation
			```
		lineageTag: 1aba5dd3-9632-455a-84f3-54e7aafc557a

	measure Variation_CSAT_Annee = ```
			
			VAR Mois_Prec = CALCULATE(
			    [CSAT],
			    (DATEADD('Dates'[Date], -1, YEAR)),
			    ALL(dataset_satisfaction_telecom)
			)
			 
			VAR  Variation_CSAT = DIVIDE( CALCULATE(
			[CSAT] - Mois_Prec), Mois_Prec)*100
			VAR Variation = 
			SWITCH(
			    TRUE(),
			    Variation_CSAT > 0, "+" & FORMAT(Variation_CSAT, "0") & "%" & "△",
			    Variation_CSAT < 0, FORMAT(Variation_CSAT, "0") & "%" & "▽ " ,
			    "↔ 0"
			)
			RETURN "(" & Variation & ")" & " " & " " & "vs" & " "& SELECTEDVALUE(Dates[Année])-1
			```
		lineageTag: a0939b3c-6999-414d-937c-8f3a35814449

	measure 'CSAT Trend Color' = ```
			
			VAR Mois_Prec = CALCULATE(
			    [CSAT],
			    SAMEPERIODLASTYEAR('Dates'[Date])
			)
			VAR  Variation_CSAT = DIVIDE( CALCULATE(
			[CSAT] - Mois_Prec), Mois_Prec)*100
			VAR VarPct = 
			SWITCH(
			    TRUE(),
			    Variation_CSAT > 0, "#4CAF50",   -- Vert
			    Variation_CSAT < 0, "#F44336",   -- Rouge
			    "#9E9E9E"                -- Gris neutre
			)
			RETURN VarPct
			```
		lineageTag: de2f274a-ee15-4cef-9642-cea5a8052137

	measure 'CSAT mois Color' = ```
			

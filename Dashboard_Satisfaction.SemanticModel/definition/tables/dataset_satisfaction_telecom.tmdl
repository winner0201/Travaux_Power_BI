	column Categorie_ces =
			
			SWITCH(
			    TRUE(),
			    dataset_satisfaction_telecom[ces] <= 2, "Aucun effort",
			    dataset_satisfaction_telecom[ces] >=4,"Effort très important",
			    "Effort modéré"
			)

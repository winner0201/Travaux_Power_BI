		annotation SummarizationSetBy = Automatic

	column Categorie_NPS =
			
			SWITCH(
			    TRUE(),
			    dataset_satisfaction_telecom[nps_score] <= 6, "Detracteurs",
			    dataset_satisfaction_telecom[nps_score] >=9, "Promoteurs",
			    TRUE(), "Passifs"

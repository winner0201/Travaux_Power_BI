	partition Dates = m
		mode: import
		source = ```
				let
				    // 1. Définir les dates de début et de fin
				    DateDebut = #date(2020, 1, 1),
				    DateFin = #date(2025, 12, 31),
				    
				    // 2. Calculer le nombre de jours entre les deux dates
				    NbJours = Duration.Days(DateFin - DateDebut) + 1,
				    
				    // 3. Générer la liste des dates
				    ListeDates = List.Dates(DateDebut, NbJours, #duration(1, 0, 0, 0)),
				    
				    // 4. Convertir la liste en une table et renommer la colonne principale
				    TableSource = Table.FromList(ListeDates, Splitter.SplitByNothing(), {"DateKey"}, null, ExtraValues.Error),
				    
				    // 5. Appliquer le type de données 'Date' à la colonne principale
				    ModifierType = Table.TransformColumnTypes(TableSource,{{"DateKey", type date}}),
				    
				    // 6. Ajouter les colonnes de temps dérivées
				    AjoutColonnes = Table.AddColumn(ModifierType, "Date", each [DateKey], type date),
				    AjoutAnnee = Table.AddColumn(AjoutColonnes, "Année", each Date.Year([DateKey]), type number),
				    AjoutMoisNum = Table.AddColumn(AjoutAnnee, "Numéro du mois", each Date.Month([DateKey]), type number),
				    AjoutMoisNom = Table.AddColumn(AjoutMoisNum, "Nom du mois", each Date.ToText([DateKey], "MMMM", "fr-FR"), type text),
				    AjoutMois = Table.AddColumn(AjoutMoisNom, "Mois", each Date.Year([DateKey]) * 100 + Date.Month([DateKey]), type number),
				    AjoutTrimestre = Table.AddColumn(AjoutMois, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([DateKey])), type text),
				    AjoutSemaine = Table.AddColumn(AjoutTrimestre, "Semaine", each Date.WeekOfYear([DateKey]), type number),
				    
				    // 7. Colonne Week-end (Samedi = 6, Dimanche = 0 en Power Query)
				    AjoutJourSemaine = Table.AddColumn(AjoutSemaine, "Jour de la semaine", each Date.DayOfWeek([DateKey], Day.Sunday)),
				    AjoutWeekend = Table.AddColumn(AjoutJourSemaine, "Week-end", each if [Jour de la semaine] = 0 or [Jour de la semaine] = 6 then "Oui" else "Non", type text),
				    
				    // 8. Nettoyage final : suppression de la colonne d'index et de jour de la semaine intermédiaire
				    ColonnesFinales = Table.SelectColumns(AjoutWeekend,{"Date", "Année", "Mois", "Nom du mois", "Numéro du mois", "Trimestre", "Semaine", "Week-end"}),
				    #"Type modifié" = Table.TransformColumnTypes(ColonnesFinales,{{"Numéro du mois", Int64.Type}}),
				    #"Colonnes renommées" = Table.RenameColumns(#"Type modifié",{{"Nom du mois", "Nom_Mois"}, {"Numéro du mois", "Numero_Mois"}})
				in
				    #"Colonnes renommées"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

